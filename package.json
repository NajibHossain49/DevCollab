{
  "name": "devcollab",
  "version": "0.1.0",
  "private": true,
  "description": "DevCollab - Real-time Collaborative Code Editor (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.6.1",
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}

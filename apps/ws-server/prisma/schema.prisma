// Prisma schema for DevCollab.
// Models mirror Section 4 of .cursor/rules.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String
  avatar       String? // GitHub avatar URL
  githubId     String? @unique // Null for email/password accounts
  passwordHash String? // Bcrypt hash; null for OAuth-only accounts

  // Relations
  ownedRooms      Room[]               @relation("RoomOwner")
  memberships     RoomMember[]
  executions      Execution[]
  messages        ChatMessage[]
  ownedOrgs       Organization[]       @relation("OrgOwner")
  orgMemberships  OrganizationMember[]
  gitIntegrations GitIntegration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([githubId])
  @@map("users")
}

// ============================================
// ORGANIZATION MODEL (Team)
// ============================================
model Organization {
  id      String @id @default(uuid())
  name    String
  slug    String @unique
  ownerId String
  owner   User   @relation("OrgOwner", fields: [ownerId], references: [id])

  members         OrganizationMember[]
  rooms           Room[]
  gitIntegrations GitIntegration[]

  // --- Billing (Stripe) ---
  // Stored in the DB so this test-mode integration is production-ready: the
  // same fields back real subscriptions once live Stripe keys are used.
  plan                 OrgPlan   @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  // Raw Stripe subscription status (active, trialing, past_due, canceled, ...).
  subscriptionStatus   String?
  // End of the current paid period; used to show renewal / expiry in the UI.
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([ownerId])
  @@map("organizations")
}

enum OrgPlan {
  FREE
  PRO
}

// ============================================
// ORGANIZATION MEMBER MODEL (Junction Table)
// ============================================
model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)
  invitedBy      String? // userId of whoever sent the invite
  invitedAt      DateTime     @default(now())
  joinedAt       DateTime?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ============================================
// ROOM MODEL
// ============================================
model Room {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique // URL-friendly: "my-awesome-room"
  description String?
  language    String  @default("javascript") // javascript, python, typescript, etc.

  // Visibility
  isPublic Boolean @default(true)

  // Relations
  ownerId    String
  owner      User          @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    RoomMember[]
  documents  Document[]
  executions Execution[]
  messages   ChatMessage[]

  // Optional owning organization (team). Null for personal rooms.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // --- Git integration ---
  // Primary linked repo for this room (used for sync / PR creation).
  gitRepoId    String?
  gitRepo      GitRepo?      @relation("RoomPrimaryRepo", fields: [gitRepoId], references: [id])
  // Repos that point back to this room (GitRepo.linkedRoomId).
  linkedRepos  GitRepo[]     @relation("RepoLinkedRoom")
  pullRequests PullRequest[]

  // Yjs document state (latest version)
  yjsState Bytes? // Binary Yjs document state

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([ownerId])
  @@index([isPublic])
  @@index([organizationId])
  @@index([gitRepoId])
  @@map("rooms")
}

// ============================================
// ROOM MEMBER MODEL (Junction Table)
// ============================================
model RoomMember {
  id     String     @id @default(uuid())
  roomId String
  userId String
  role   MemberRole @default(EDITOR)

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_members")
}

enum MemberRole {
  OWNER // Full control
  EDITOR // Can edit code
  VIEWER // Read-only
}

// ============================================
// DOCUMENT MODEL (Version History)
// ============================================
model Document {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Yjs document state at this version
  yjsState Bytes

  // Version info
  version  Int
  snapshot String? // Human-readable snapshot for debugging

  createdAt DateTime @default(now())

  @@unique([roomId, version])
  @@index([roomId])
  @@index([createdAt])
  @@map("documents")
}

// ============================================
// EXECUTION MODEL (Code Run History)
// ============================================
model Execution {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Code that was executed
  code     String @db.Text
  language String

  // Results
  output String?         @db.Text
  error  String?         @db.Text
  status ExecutionStatus @default(PENDING)

  // Metadata
  executedById  String
  executedBy    User   @relation(fields: [executedById], references: [id], onDelete: Cascade)
  executionTime Int? // milliseconds

  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([executedById])
  @@index([createdAt])
  @@map("executions")
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
  TIMEOUT
}

// ============================================
// CHAT MESSAGE MODEL (Room Chat)
// ============================================
model ChatMessage {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ============================================
// GIT INTEGRATION MODELS (Project Management)
// ============================================
model GitIntegration {
  id       String      @id @default(uuid())
  provider GitProvider

  // OAuth tokens, stored encrypted at rest (AES-256-GCM). Never returned raw.
  accessToken    String
  refreshToken   String?
  // Provider account handle/login for display.
  accountLogin   String?
  // Token expiry (for providers that issue short-lived tokens, e.g. GitLab).
  tokenExpiresAt DateTime?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  repos GitRepo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, ownerId])
  @@index([ownerId])
  @@map("git_integrations")
}

model GitRepo {
  id            String         @id @default(uuid())
  integrationId String
  integration   GitIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  providerRepoId String // The provider's own repo id
  name           String
  fullName       String // owner/repo
  url            String
  defaultBranch  String  @default("main")
  isPrivate      Boolean @default(false)

  isLinked     Boolean @default(false)
  linkedRoomId String?
  room         Room?   @relation("RepoLinkedRoom", fields: [linkedRoomId], references: [id])

  // Rooms that use this repo as their primary repo (Room.gitRepoId).
  primaryForRooms Room[] @relation("RoomPrimaryRepo")

  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([integrationId, providerRepoId])
  @@index([integrationId])
  @@index([linkedRoomId])
  @@map("git_repos")
}

model PullRequest {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  provider    GitProvider
  prNumber    Int
  title       String
  description String?
  branchFrom  String
  branchTo    String
  status      PRStatus    @default(OPEN)
  url         String
  createdBy   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@map("pull_requests")
}

enum GitProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

enum PRStatus {
  OPEN
  CLOSED
  MERGED
}

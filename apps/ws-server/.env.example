# ==============================================================================
# DevCollab ws-server — environment variables
# ------------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# Legend:  [REQUIRED] must be set   |   [OPTIONAL] has a default / can be empty
# All *_URL values must be valid URLs. NEXTAUTH_SECRET must be >= 32 chars.
# ==============================================================================

# --- Database -----------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string.
# Local dev uses the bundled docker-compose Postgres, mapped to host port 5433
# (host 5432 is often taken by a native Postgres install).
# Start it with: docker compose -f docker-compose.yml up -d postgres
DATABASE_URL="postgresql://devcollab:devcollab@localhost:5433/devcollab?schema=public"

# --- Redis --------------------------------------------------------------------
# [REQUIRED] Redis connection string (used for rate limiting).
# Local dev uses the bundled docker-compose Redis on port 6379.
# Start it with: docker compose -f docker-compose.yml up -d redis
REDIS_URL="redis://localhost:6379"

# --- Auth (GitHub OAuth) ------------------------------------------------------
# [REQUIRED] GitHub OAuth app credentials.
# Create an OAuth app at: https://github.com/settings/developers
#   -> New OAuth App -> set Authorization callback URL to your frontend callback.
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# [REQUIRED] Secret used to sign JWTs / sessions (minimum 32 characters).
# Generate one with:   openssl rand -base64 32
#                 or:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MUST be identical to the web app's AUTH_SECRET (apps/web/.env.local) so that
# WebSocket JWTs verify. Startup logs a fingerprint you can compare between apps.
NEXTAUTH_SECRET="replace_with_a_random_secret_at_least_32_chars"

# [REQUIRED] Public base URL of the app (used for OAuth + CORS allow-list).
# Development default shown below; set to your deployed URL in production.
NEXTAUTH_URL="http://localhost:3001"

# [OPTIONAL] Extra browser origins allowed by CORS, comma-separated.
# localhost:3000 is always allowed for local dev; add your deployed frontend
# URL(s) here in production, e.g. the Vercel domain:
#   CORS_ORIGINS="https://devcollab.vercel.app,https://www.devcollab.app"
CORS_ORIGINS="*"

# --- Server -------------------------------------------------------------------
# [OPTIONAL] HTTP/WebSocket port. Default: 3001
PORT=3001

# [OPTIONAL] Runtime mode: development | production | test. Default: development
NODE_ENV=development

# --- AI -----------------------------------------------------------------------
# [OPTIONAL] Groq API key — powers AI completions and the "Explain code" feature.
# Get a key at: https://console.groq.com/keys  (leave empty to disable AI features)
GROQ_API_KEY=""

# --- Email (SendGrid — free tier: 100 emails/day) -----------------------------
# [OPTIONAL] SendGrid API key for sending team invite / welcome / role-change
# emails. Create one at: https://app.sendgrid.com/settings/api_keys
# Leave empty to disable outbound email — invites still work and return a
# shareable link you can send manually.
SENDGRID_API_KEY=""
# [OPTIONAL] Verified sender identity (must be a verified sender in SendGrid).
SENDGRID_FROM_EMAIL="no-reply@devcollab.app"
SENDGRID_FROM_NAME="DevCollab"
# [OPTIONAL] Daily send cap. SendGrid free tier allows 100 emails/day.
SENDGRID_DAILY_LIMIT=100

# [OPTIONAL] Public base URL of the web frontend, used to build invite links.
# Falls back to NEXTAUTH_URL when unset. Set to your Vercel domain in prod.
WEB_APP_URL="http://localhost:3000"

# --- Code Execution (Codex API by Jaagrav) ------------------------------------
# [OPTIONAL] Codex code-execution API base URL for running submitted code.
#
# The public instance (https://api.codex.jaagrav.in/) requires no API key and is
# the default. Supported languages: JavaScript, Python, Java, C++, Go
# (TypeScript runs as JavaScript; Rust is not supported by Codex).
# Override this only if you self-host Codex.
CODEX_API_URL="https://api.codex.jaagrav.in/"

# --- Logging ------------------------------------------------------------------
# [OPTIONAL] Pino log level: debug | info | warn | error. Default: info
LOG_LEVEL=debug

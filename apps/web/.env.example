# ==============================================================================
# DevCollab web (Next.js) — environment variables
# Copy to `.env.local` and fill in real values:  cp .env.example .env.local
# Legend:  [REQUIRED] must be set  |  [OPTIONAL] has a default
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.
# ==============================================================================

# --- Backend API --------------------------------------------------------------
# [REQUIRED] Base URL of the ws-server REST API.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# [REQUIRED] WebSocket endpoint of the ws-server (note the /ws path).
NEXT_PUBLIC_WS_URL="ws://localhost:3001/ws"

# --- Auth.js (NextAuth v5) ----------------------------------------------------
# [REQUIRED] Secret used to encrypt the session JWT (minimum 32 chars).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace_with_a_random_secret_at_least_32_chars"

# [OPTIONAL] Canonical URL of this app. Auto-detected in most cases.
AUTH_URL="http://localhost:3000"

# [REQUIRED] GitHub OAuth app credentials.
# Create one at: https://github.com/settings/developers
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"

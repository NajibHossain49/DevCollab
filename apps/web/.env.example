# ==============================================================================
# DevCollab web (Next.js) — environment variables
# Copy to `.env.local` and fill in real values:  cp .env.example .env.local
# Legend:  [REQUIRED] must be set  |  [OPTIONAL] has a default
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.
# ==============================================================================

# --- Backend API --------------------------------------------------------------
# [REQUIRED] Base URL of the ws-server REST API.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# [REQUIRED] WebSocket endpoint of the ws-server (note the /ws path).
NEXT_PUBLIC_WS_URL="ws://localhost:3001/ws"

# [OPTIONAL] Base URL of the code-execution service. Only used to pre-warm it
# in the background so it doesn't cold-start on the first run (Render free tier
# sleeps after ~15 min idle). Leave empty to skip warm-up.
NEXT_PUBLIC_CODEX_URL=""

# --- WebRTC (audio/video call + screen share) ---------------------------------
# STUN uses Google's free public servers automatically. A TURN relay is only
# needed to traverse symmetric NATs / restrictive networks. Sign up for a free
# tier (e.g. Metered.ca or GetStream) and fill these in. Leave empty to run
# STUN-only (works on most networks). Multiple TURN URLs may be comma-separated.
# NEXT_PUBLIC_* values are exposed to the browser — TURN credentials are, by
# design, client-visible for WebRTC, so use short-lived/limited credentials.
NEXT_PUBLIC_TURN_SERVER_URL=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_PASSWORD=""

# --- Auth.js (NextAuth v5) ----------------------------------------------------
# [REQUIRED] Secret used to encrypt the session JWT (minimum 32 chars).
# Generate one with:  openssl rand -base64 32
# MUST be identical to the ws-server's NEXTAUTH_SECRET — the web app signs
# WebSocket JWTs with this value and the ws-server verifies them with that one.
# On startup both apps log a matching fingerprint you can compare.
AUTH_SECRET="replace_with_a_random_secret_at_least_32_chars"

# [REQUIRED] Canonical URL of this app. 
AUTH_URL="http://localhost:3000"

# [REQUIRED] GitHub OAuth app credentials.
# Create one at: https://github.com/settings/developers
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"
